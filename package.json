{
  "name": "affiliate-poppy",
  "version": "0.1.2",
  "private": true,
  "description": "Affiliate programs that run entirely in your own AWS — an AgentsPoppy extension.",
  "type": "module",
  "license": "PolyForm-Shield-1.0.0",
  "workspaces": [
    "infra",
    "lambdas",
    "backend",
    "frontend"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "gen:backend": "node scripts/build-backend-bundle.mjs",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run build -w @affiliatepoppy/frontend",
    "prebuild:backend": "npm run gen:backend",
    "build:backend": "node scripts/build-backend.mjs",
    "validate-manifest": "node scripts/validate-manifest.mjs",
    "sync-feedback": "node ${AGENTSPOPPY_REPO:-../agentspoppy}/scripts/sync-feedback-tab.mjs --dest frontend/src/vendor",
    "check-feedback": "node ${AGENTSPOPPY_REPO:-../agentspoppy}/scripts/sync-feedback-tab.mjs --dest frontend/src/vendor --check",
    "pack": "npm run build && node ${AGENTSPOPPY_REPO:-../agentspoppy}/scripts/pack-extension.mjs --src . --frontend frontend/dist",
    "install-dev": "npm run build && node ${AGENTSPOPPY_REPO:-../agentspoppy}/scripts/install-dev-extension.mjs --src . --frontend frontend/dist --backend backend/index.cjs",
    "certify": "npm --prefix ${AGENTSPOPPY_REPO:-../agentspoppy} run certify -- --extension $PWD"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
